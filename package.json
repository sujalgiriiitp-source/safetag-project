{
  "name": "safetag",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22 <25" },
  "overrides": { "postcss-selector-parser": "7.1.6" },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --webpack",
    "build": "node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "eslint app components lib models tests scripts types --max-warnings 0",
    "test": "NODE_ENV=test node --import tsx --test --test-concurrency=1 tests/*.test.mts",
    "test:e2e": "playwright test",
    "verify:local": "node --import tsx scripts/verify-local.ts",
    "pilot:indexes": "node --import tsx scripts/pilot-indexes.ts",
    "pilot:worker": "node --import tsx scripts/pilot-worker.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "seed": "node --import tsx scripts/seed.ts",
    "demo:hash-password": "node --import tsx scripts/hash-demo-password.ts"
  },
  "dependencies": {
    "@google-cloud/vision": "6.2.0",
    "@radix-ui/react-slot": "^1",
    "@yudiel/react-qr-scanner": "^2",
    "caniuse-lite": "^1.0.30001788",
    "class-variance-authority": "^0.7",
    "cloudinary": "^2",
    "clsx": "^2",
    "jspdf": "4.2.1",
    "lucide-react": "^0.469",
    "mongoose": "^8",
    "next": "16.4.3",
    "next-themes": "^0.4",
    "nodemailer": "10.2.1",
    "otpauth": "9.5.2",
    "qrcode.react": "^4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "sonner": "^1",
    "tailwind-merge": "^2",
    "twilio": "6.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "node": "^22.23.4",
    "postcss": "^8",
    "tailwindcss": "^3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
