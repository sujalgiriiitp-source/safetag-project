MONGODB_URI=
# Local demonstration mode: never enable in production. Leave MONGODB_URI empty.
DEMO_MODE=false
DEMO_USERNAME=
DEMO_PASSWORD_HASH=
DEMO_DISPLAY_PASSWORD=
SESSION_SECRET=
# Independent high-entropy secret, at least 32 bytes. Keep stable while receipts are active.
TOKEN_SECRET=
# Platform access requires phone OTP plus TOTP. Single-admin controlled pilot only.
PLATFORM_ADMIN_PHONES=
PLATFORM_ADMIN_TOTP_SECRET=
# Twilio Verify is required for real staff OTP. Notifications require separate opt-in/setup.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VERIFY_SERVICE_SID=
NOTIFICATIONS_ENABLED=false
TWILIO_MODE=sandbox
TWILIO_STORED_CONTENT_SID=
TWILIO_RETURNED_CONTENT_SID=
# Only explicitly authorized sandbox recipients, comma-separated E.164 numbers.
NOTIFICATION_TEST_RECIPIENTS=
ALLOW_AUTHORIZED_TEST_SEND=false
LEGACY_NOTIFICATIONS_ENABLED=false
# mongo is the locally tested private adapter; cloudinary needs a separate access/expiry drill.
STORAGE_DRIVER=mongo
# Protect the optional scheduled jobs endpoint; alternatively use npm run pilot:worker.
CRON_SECRET=
GOOGLE_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_VISION_PROJECT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXTAUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Free email notifications via Gmail SMTP (recommended — the free default channel).
# Create via Google Account → Security → 2-Step Verification → App passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Manual venue subscription: the venue pays via any UPI app to this ID;
# the admin then activates the subscription manually in the superadmin panel.
SUBSCRIPTION_UPI_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
